<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ui.ViewModels"
        xmlns:ui="using:Ui"
        x:Class="Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Compressor"
        Icon="/Assets/compressor.ico"
        Width="1150" Height="760" MinWidth="820" MinHeight="520">

  <Window.Resources>
    <ui:HintBrushConverter x:Key="HintBrush" />
    <ui:StateBrushConverter x:Key="StateBrush" />
  </Window.Resources>

  <Window.Styles>
    <!-- Step indicator: shows where you are; not clickable. -->
    <Style Selector="Border.step">
      <Setter Property="Padding" Value="0,0,0,6" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.step > TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Border.step.current > TextBlock">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.stepArrow">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Opacity" Value="0.3" />
    </Style>

    <!-- Action bar: same place on every step, main action rightmost. -->
    <Style Selector="Button.action">
      <Setter Property="MinWidth" Value="130" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Tree rows: the folder name is a Run so only the name, not the suffix, is bold or struck through. -->
    <Style Selector="Run.unit">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Run.excluded">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Run.suffix">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    </Style>
    <Style Selector="TextBlock.covered">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.excluded">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="Padding" Value="12,8" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Button Content="Open folder…" Click="OnOpenFolder" IsEnabled="{Binding !IsRunning}" />
          <Button Content="Load job…" Click="OnLoadJob" IsEnabled="{Binding !IsRunning}" />
          <Button Content="Save job…" Click="OnSaveJob" IsEnabled="{Binding HasRoot}" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Help" Margin="12,0,0,0" AutomationProperties.Name="Help">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Check for updates…" Click="OnCheckForUpdates" />
              <Separator />
              <MenuItem Header="About Compressor" Click="OnAbout" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SevenZipStatus}" Classes="muted" VerticalAlignment="Center" />
        <TextBlock Text="{Binding RootPath}" VerticalAlignment="Center" Margin="16,0"
                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
      </DockPanel>
    </Border>

    <!-- ── Banners ─────────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top" Classes="banner" Background="#40C2453A"
            IsVisible="{Binding SevenZipError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <SelectableTextBlock Text="{Binding SevenZipError}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Top" Classes="banner" Background="#40C2453A"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top" />
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- ── Step indicator ──────────────────────────────────────────────────── -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="12,12,12,4">
      <Border Classes="step" Classes.current="{Binding IsChooseStep}"><TextBlock Text="1. Choose folders" /></Border>
      <TextBlock Text="›" Classes="stepArrow" />
      <Border Classes="step" Classes.current="{Binding IsCheckStep}"><TextBlock Text="2. Check" /></Border>
      <TextBlock Text="›" Classes="stepArrow" />
      <Border Classes="step" Classes.current="{Binding IsRunStep}"><TextBlock Text="3. Run" /></Border>
    </StackPanel>

    <!-- ── Status bar ──────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsScanning}" />
        <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsChecking}" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- ── Action bar: each step's summary on the left, its buttons on the right ─ -->
    <Border DockPanel.Dock="Bottom" Padding="12,10" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="← Back" Command="{Binding BackCommand}" IsVisible="{Binding ShowCheckActions}" />
          <Button Content="← Choose folders" Command="{Binding BackCommand}" IsVisible="{Binding IsRunStep}" />
          <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsRunStep}" Classes="action" />
          <Button Content="{Binding CheckButtonText}" Command="{Binding CheckCommand}" IsVisible="{Binding IsChooseStep}"
                  Classes="accent action"
                  ToolTip.Tip="Builds the job and checks for problems before anything is written." />
          <Button Content="Cancel" Command="{Binding CancelCheckCommand}" IsVisible="{Binding IsChecking}" Classes="action" />
          <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}" IsVisible="{Binding ShowCheckActions}"
                  Classes="accent action" />
        </StackPanel>
        <Panel Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" IsVisible="{Binding IsChooseStep}" />
          <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" IsVisible="{Binding IsCheckStep}" />
          <SelectableTextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" IsVisible="{Binding IsRunStep}" />
        </Panel>
      </DockPanel>
    </Border>

    <Panel Margin="12,8,12,10">

      <!-- ── 1. Choose folders ─────────────────────────────────────────────── -->
      <Grid ColumnDefinitions="*,320" IsVisible="{Binding IsChooseStep}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Tick a folder to turn it into one .7z archive next to it. Untick a subfolder of a ticked folder to leave it out. Everything else stays as it is." />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,40,0,0" HorizontalAlignment="Center"
                     Text="Open a folder to see its contents." IsVisible="{Binding !HasRoot}" />
          <!--
            Columns are fixed-width and anchored to the right edge of each row, so they line up at every depth:
            the indentation only narrows the name column. The right margin keeps the last column clear of the
            scrollbar. Keep the header's widths and margin in sync with the rows'.
          -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,84,88,88,84" Margin="0,0,20,4"
                IsVisible="{Binding HasRoot}">
            <TextBlock Text="Folder" Classes="columnHeader" HorizontalAlignment="Left" Margin="12,0,0,0" />
            <TextBlock Grid.Column="1" Text="Hint" Classes="columnHeader" HorizontalAlignment="Left" Margin="14,0,0,0" />
            <TextBlock Grid.Column="2" Text="Size" Classes="columnHeader" />
            <TextBlock Grid.Column="3" Text="Est. 7z" Classes="columnHeader" />
            <TextBlock Grid.Column="4" Text="Files" Classes="columnHeader" />
          </Grid>
          <TreeView ItemsSource="{Binding Tree}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
              <!-- Let each row's content fill the width, so the right-anchored columns line up. -->
              <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,84,88,88,84" Margin="0,0,20,0">
                  <DockPanel>
                    <!-- Text built from Runs has no accessible name of its own: name both explicitly for screen readers. -->
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsMarked, Mode=TwoWay}" IsVisible="{Binding !IsPlaceholder}"
                              AutomationProperties.Name="{Binding Name}"
                              VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="0,0,8,0" />
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}"
                               AutomationProperties.Name="{Binding Name}"
                               Classes.covered="{Binding IsCovered}" Classes.excluded="{Binding IsExcluded}"
                               Classes.muted="{Binding IsPlaceholder}">
                      <Run Text="{Binding Name}" Classes.unit="{Binding IsUnit}" Classes.excluded="{Binding IsExcluded}" />
                      <Run Text="{Binding MarkSuffix}" Classes="suffix" />
                    </TextBlock>
                  </DockPanel>
                  <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Left" Margin="14,0,0,0"
                          Background="{Binding Hint, Converter={StaticResource HintBrush}}"
                          IsVisible="{Binding HintText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding HintText}" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="column" />
                  <TextBlock Grid.Column="3" Text="{Binding EstimateText}" Classes="column" Opacity="0.75" />
                  <TextBlock Grid.Column="4" Text="{Binding FilesText}" Classes="column" Opacity="0.75" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
          <!-- Right margin keeps the text clear of the scrollbar. -->
          <StackPanel Spacing="14" Margin="0,0,16,0">
            <TextBlock Text="Settings" Classes="heading" />

            <StackPanel Spacing="4">
              <TextBlock Text="Compression" />
              <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="CPU use" />
              <ComboBox ItemsSource="{Binding ParallelismLevels}" SelectedItem="{Binding SelectedParallelism}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="If the archive name is taken" />
              <ComboBox ItemsSource="{Binding CollisionOptions}" SelectedItem="{Binding SelectedCollision}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="If a file is locked" />
              <ComboBox ItemsSource="{Binding LockedOptions}" SelectedItem="{Binding SelectedLocked}" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Spacing="4">
              <CheckBox IsChecked="{Binding DeleteAfterVerify}" AutomationProperties.Name="Delete originals after each archive is verified">
                <TextBlock Text="Delete originals after each archive is verified" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock IsVisible="{Binding DeleteAfterVerify}" TextWrapping="Wrap" FontSize="12" Foreground="#C2453A"
                         Text="Only files that are unchanged since they were archived are deleted. Anything else is kept and flagged." />
            </StackPanel>

            <Separator />
            <TextBlock Text="Checking" Classes="heading" />

            <StackPanel Spacing="4">
              <CheckBox IsChecked="{Binding CheckLockedFiles}" AutomationProperties.Name="Look for locked files first">
                <TextBlock Text="Look for locked files first (slow: opens every file)" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Without this, a locked file is found during compression instead: that folder is flagged for review and nothing is deleted." />
            </StackPanel>

            <StackPanel Spacing="4">
              <CheckBox IsChecked="{Binding StartAutomatically}" AutomationProperties.Name="Start automatically after checking">
                <TextBlock Text="Start automatically after checking" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="So you can walk away: compression starts as soon as the check is done, unless disk space may run out." />
            </StackPanel>

            <Separator />
            <TextBlock Text="Hints" Classes="heading" />
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge" Background="#3D9A50"><TextBlock Text="good" /></Border>
                <TextBlock Text="mostly text, documents, data" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge" Background="#C28A00"><TextBlock Text="average" /></Border>
                <TextBlock Text="mixed or unknown types" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="badge" Background="#C2453A"><TextBlock Text="poor" /></Border>
                <TextBlock Text="mostly photos, video, archives" VerticalAlignment="Center" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ── 2. Check ──────────────────────────────────────────────────────── -->
      <DockPanel IsVisible="{Binding IsCheckStep}">
        <Border DockPanel.Dock="Top" Classes="banner" Background="#40C2453A" Margin="0,0,0,8"
                IsVisible="{Binding DeleteAfterVerify}">
          <TextBlock TextWrapping="Wrap"
                     Text="Original files will be deleted once their archive is verified. Only files unchanged since archiving are deleted." />
        </Border>

        <Panel>
        <!-- While checking: a bar that fills up, so it's clear the check is moving (and much faster than compressing). -->
        <StackPanel IsVisible="{Binding IsChecking}" Spacing="8" VerticalAlignment="Top" Margin="0,8,0,0" MaxWidth="720"
                    HorizontalAlignment="Left">
          <TextBlock Text="Checking…" Classes="heading" />
          <ProgressBar Value="{Binding CheckProgress}" Maximum="100" Height="10"
                       IsIndeterminate="{Binding !IsCheckProgressKnown}" />
          <TextBlock Text="{Binding CheckProgressText}" />
          <TextBlock Text="{Binding CheckExplanation}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid RowDefinitions="Auto,2*,Auto,*" IsVisible="{Binding HasPlan}">
          <!-- Same column order as the folder tree; same scrollbar margin in header and rows. -->
          <Grid ColumnDefinitions="*,84,88,88,84,240" Margin="12,0,32,4">
            <TextBlock Text="Folder" Classes="columnHeader" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="Hint" Classes="columnHeader" HorizontalAlignment="Left" Margin="14,0,0,0" />
            <TextBlock Grid.Column="2" Text="Size" Classes="columnHeader" />
            <TextBlock Grid.Column="3" Text="Est. 7z" Classes="columnHeader" />
            <TextBlock Grid.Column="4" Text="Files" Classes="columnHeader" />
            <TextBlock Grid.Column="5" Text="Archive" Classes="columnHeader" HorizontalAlignment="Left" Margin="20,0,0,0" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding PlanItems}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PlanItemRow">
                <Grid ColumnDefinitions="*,84,88,88,84,240" Margin="0,0,20,0">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="badge" Margin="14,0,0,0" HorizontalAlignment="Left"
                          Background="{Binding Hint, Converter={StaticResource HintBrush}}"
                          IsVisible="{Binding HintText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding HintText}" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="column" />
                  <TextBlock Grid.Column="3" Text="{Binding Estimate}" Classes="column" Opacity="0.75" />
                  <TextBlock Grid.Column="4" Text="{Binding Files}" Classes="column" Opacity="0.75" />
                  <TextBlock Grid.Column="5" Text="{Binding Output}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="2" Text="Warnings" Classes="heading" Margin="0,12,0,6" IsVisible="{Binding HasWarnings}" />
          <ScrollViewer Grid.Row="3">
            <ItemsControl ItemsSource="{Binding Warnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WarningGroup">
                  <Expander Header="{Binding Header}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
        </Panel>
      </DockPanel>

      <!-- ── 3. Run ────────────────────────────────────────────────────────── -->
      <DockPanel IsVisible="{Binding IsRunStep}">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
          <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="10" />
          <TextBlock Text="{Binding RunStatus}" Classes="muted" />
        </StackPanel>

        <ListBox ItemsSource="{Binding RunItems}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JobItemViewModel">
              <Grid ColumnDefinitions="*,130,180" RowDefinitions="Auto,Auto" Margin="0,0,20,0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Left"
                        Background="{Binding State, Converter={StaticResource StateBrush}}">
                  <TextBlock Text="{Binding StateText}" />
                </Border>
                <ProgressBar Grid.Column="2" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" />
                <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Detail}" TextWrapping="Wrap"
                                     FontSize="12" Opacity="0.8"
                                     IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Panel>
  </DockPanel>
</Window>
